{
  "info": {
    "name": "SIPUS-Del Web Services API v1",
    "_postman_id": "sipus-del-week9-collection",
    "description": "Koleksi uji resmi praktikum Minggu 9 PPW - Layanan SOAP Bebas Pustaka & RESTful API v1 SIPUS-Del",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. SOAP Legacy",
      "item": [
        {
          "name": "WSDL Contract",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8000/soap/sipus.wsdl" }
          }
        },
        {
          "name": "SOAP Clearance Check (200 OK)",
          "request": {
            "method": "POST",
            "url": { "raw": "http://localhost:8000/soap/sipus" },
            "header": [{ "key": "Content-Type", "value": "text/xml; charset=utf-8" }],
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:m=\"http://sipus.del.ac.id/soap/clearance\">\n    <soap:Body>\n        <m:CheckClearanceStatusRequest>\n            <m:nim_peminjam>12S24029</m:nim_peminjam>\n        </m:CheckClearanceStatusRequest>\n    </soap:Body>\n</soap:Envelope>"
            }
          }
        },
        {
          "name": "SOAP Fault (500 Error)",
          "request": {
            "method": "POST",
            "url": { "raw": "http://localhost:8000/soap/sipus" },
            "header": [{ "key": "Content-Type", "value": "text/xml; charset=utf-8" }],
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n    <soap:Body>\n        <soap:Fault-Trigger/>\n    </soap:Body>\n</soap:Envelope>"
            }
          }
        }
      ]
    },
    {
      "name": "02. Authentication",
      "item": [
        {
          "name": "Login Pustakawan",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/auth/login" },
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pustakawan@del.ac.id\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Profil Aktif (Me)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "method": "GET",
            "url": { "raw": "{{base_url}}/auth/me" },
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        },
        {
          "name": "Logout Token Revocation",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "method": "POST",
            "url": { "raw": "{{base_url}}/auth/logout" },
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        }
      ]
    },
    {
      "name": "03. Katalog Buku Provider",
      "item": [
        {
          "name": "GET Katalog Terpaginasi & HATEOAS",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/bukus?per_page=5&tersedia=1" },
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        },
        {
          "name": "POST Buku Baru (201 Created)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "method": "POST",
            "url": { "raw": "{{base_url}}/bukus" },
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kategori_id\": 1,\n  \"isbn\": \"9780132350884\",\n  \"judul\": \"Clean Code\",\n  \"penulis\": \"Robert C. Martin\",\n  \"penerbit\": \"Prentice Hall\",\n  \"tahun_terbit\": 2008,\n  \"stok\": 5\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "PATCH Update Stok Parsial",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "method": "PATCH",
            "url": { "raw": "{{base_url}}/bukus/1" },
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stok\": 12\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "DELETE Buku (Tolak 409 Jika Ada Pinjaman)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/bukus/1" },
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        }
      ]
    },
    {
      "name": "04. Sirkulasi Peminjaman ACID",
      "item": [
        {
          "name": "POST Pinjam Buku (201 Created + ACID Lock)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "method": "POST",
            "url": { "raw": "{{base_url}}/peminjamans" },
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"buku_id\": 1,\n  \"nim_peminjam\": \"12S24029\",\n  \"nama_peminjam\": \"Mahasiswa Del\",\n  \"durasi_hari\": 7\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "PATCH Pengembalian Buku (+1 Stok)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "method": "PATCH",
            "url": { "raw": "{{base_url}}/peminjamans/1/kembalikan" },
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        }
      ]
    },
    {
      "name": "05. REST Service Consumer",
      "item": [
        {
          "name": "GET Referensi Metadata Eksternal",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/bukus/1/referensi-eksternal" },
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        }
      ]
    }
  ]
}